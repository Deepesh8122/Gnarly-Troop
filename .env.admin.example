# Private admin deployment — NEVER commit real values; use host secret manager only.
# Copy to .env.local on a private admin host (separate subdomain recommended).

ENABLE_ADMIN=true

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for CMS writes (Supabase → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SITE_URL=https://admin.yoursite.com
NEXT_PUBLIC_CMS_ENABLED=true

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

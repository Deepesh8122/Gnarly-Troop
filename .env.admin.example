# MailerSend — Option A: SMTP + trial domain (no DNS setup, good for testing)
# app.mailersend.com → Domains → Trial domain → Manage → SMTP → Generate new user
EMAIL_HOST=smtp.mailersend.net
EMAIL_PORT=587
EMAIL_USER=MS_xxxxxx@smtp.mailersend.net
EMAIL_PASS=your-mailersend-smtp-password
EMAIL_FROM="Gnarly Troop <MS_xxxxxx@smtp.mailersend.net>"


# Environment templates — see docs/SECURITY.md
#
# Public site:  copy .env.public.example  → .env.local
# Admin CMS:    copy .env.admin.example   → .env.local (private host only)

# Quick local dev (admin + site on same machine):
ENABLE_ADMIN=true
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_SECRET
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_ENABLED=true

# Public website deployment — copy to .env.local on Vercel/hosting (FRONTEND ONLY)
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here.

ENABLE_ADMIN=false

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required on production — must be your live domain (NOT localhost), e.g. https://www.gnarlytroop.org
NEXT_PUBLIC_SITE_URL=https://www.yoursite.com
NEXT_PUBLIC_CMS_ENABLED=true

# PhonePe (server-side only — set in host env UI, not in public repo)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
# sandbox = UAT/test dashboard | production (or live) = live PhonePe dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

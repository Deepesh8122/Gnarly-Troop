# Public website deployment — copy to .env.local on Vercel/hosting (FRONTEND ONLY)
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here.

ENABLE_ADMIN=false

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SITE_URL=https://www.yoursite.com
NEXT_PUBLIC_CMS_ENABLED=true

# Brochure / PhonePe (public APIs only — keys stay server-side in host env UI)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

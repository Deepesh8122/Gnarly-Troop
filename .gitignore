# See https://help.github.com/articles/ignoring-files/

# -----------------------------------------------------------------------------
# Dependencies & build
# -----------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
/app/generated/prisma

# -----------------------------------------------------------------------------
# Secrets & local environment (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.public.example
!.env.admin.example

*.pem
*.key
*.p12
*.pfx
secrets/
.credentials/

# Payment / legacy DB (server-only)
phonepe*.json
razorpay*.json

# -----------------------------------------------------------------------------
# Hosting & local tooling
# -----------------------------------------------------------------------------
.vercel
.turbo
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# -----------------------------------------------------------------------------
# Database schema & seeds (PRIVATE — distribute via secure channel only)
# See docs/SECURITY.md and supabase/README.md
# -----------------------------------------------------------------------------
/supabase/migrations/
/supabase/seed.sql
/supabase/RUN_ONLY_IF_MISSING.sql
/supabase/**/*.local.sql

# -----------------------------------------------------------------------------
# CMS / admin source (PRIVATE repo or private branch only)
# Public GitHub should use a frontend-only clone; see docs/SECURITY.md
# -----------------------------------------------------------------------------
/app/(admin)/
/lib/admin/
/components/admin/
/app/api/admin/
/docs/CMS_ARCHITECTURE.md
/docs/FIX_CONNECTION_NOW.md

# Optional: internal security notes (keep local)
/security/local-notes.md
